{
  "name": "@kroszborg/rune-vue",
  "version": "1.0.0",
  "description": "Vue 3 component for Rune — lightweight, fully customizable QR codes.",
  "author": "Abhiman Panwar (@kroszborg)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": ["qr", "qrcode", "vue", "svg", "component"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kroszborg/rune.git",
    "directory": "packages/rune-vue"
  },
  "homepage": "https://rune.kroszborg.co",
  "bugs": {
    "url": "https://github.com/Kroszborg/rune/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@kroszborg/rune": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "vue": "^3.5.13",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
