{
  "name": "@kroszborg/rune-wc",
  "version": "1.0.0",
  "description": "Vanilla JS + Web Component (<rune-qr>) for Rune — customizable QR codes with no framework.",
  "author": "Abhiman Panwar (@kroszborg)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "qr",
    "qrcode",
    "web-component",
    "custom-element",
    "vanilla",
    "svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kroszborg/rune.git",
    "directory": "packages/rune-wc"
  },
  "homepage": "https://rune.kroszborg.co",
  "bugs": {
    "url": "https://github.com/Kroszborg/rune/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@kroszborg/rune": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
